<title>Feliz cumpleaños 💗</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🦋</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,400&family=Nunito:wght@400;700;800&display=swap">

<script>
/* ═══════════════════════════════════════════════
   ✏️  EDITA AQUÍ: nombres, textos y canción
   ═══════════════════════════════════════════════ */
const CFG = {
  ella: "preciosa mía",     // cómo la llamas
  yo:   "tu Kairi",         // cómo firmas tú
  mes: 11, dia: 30,         // fecha del cumpleaños (mes normal: 11 = noviembre)

  cancion: {
    titulo:  "Summertime",
    artista: "My Chemical Romance",
    frase:   "Puedes escapar conmigo cuando quieras.",
    spotify: "7cQjIIjLOhbRVCXyIepF2U",   // ID del track en Spotify
    youtube: "",   // o ID de YouTube. De youtube.com/watch?v=XYZ789  →  "XYZ789"
    archivo: ""    // o un mp3 subido al repo, ej. "summertime.mp3"
  },

  fotos: [],       // fotos de ustedes subidas al repo, ej. ["foto1.jpg","foto2.jpg"]

  recuerdos: [     // Capítulo 1: [imagen, texto]
    ["lis-abrazo", "Me salvaste de más formas de las que imaginas."],
    ["lis-rieles", "Contigo, hasta caminar en equilibrio parece fácil."],
    ["lis-beso",   "Si pudiera rebobinar, te besaría todas las veces."],
    ["lis-chibi",  "Eres mi compañera de aventuras, de tonterías y de todo."],
    ["lis-double", "Tu sonrisa es mi momento favorito en cualquier línea temporal."]
  ],

  decisiones: [    // Capítulo 1: [opción, respuesta]
    ["Abrazarnos, sin soltarnos",      "Buena elección. Te aviso desde ya: no pienso soltarte en un buen rato."],
    ["Darnos nuestro primer beso",     "El primero de muchos, aunque posiblemente me ponga muy nerviosa con tu belleza."],
    ["Tener nuestra primera cita en una cafetería", "Será un día con exceso de dulzura (por ti, claro). Y sí: habrá pastel."]
  ],

  miraculous: [    // Capítulo 2: [botón, texto]
    ["Tikki, spots on! 🐞",      "¡Transformación completa! Ahora conoces mi identidad secreta: estoy completamente enamorada de ti."],
    ["Lucky Charm! 🍀",          "Tu amuleto de la suerte es… un abrazo infinito 🤗. Úsalo cada vez que me extrañes."],
    ["Miraculous Ladybug! ✨",   "Y todo vuelve a estar bien. Eso haces tú conmigo: arreglas mis días con solo aparecer."]
  ],

  apoyo: [         // Capítulo 3: [rango, texto]
    ["C", "Todo empezó con un «hola» y muchos nervios."],
    ["B", "Sin darme cuenta, te volviste la primera persona a quien quería contarle todo."],
    ["A", "Te convertiste en mi lugar seguro, aunque estés a kilómetros."],
    ["S", "Te amo, te elijo y quiero un futuro contigo. 💍"]
  ],

  distancia: [     // Capítulo 4: [desde %, texto]
    [0,   "Tan lejos… y aun así, siempre en mi mente."],
    [20,  "Cada mensaje tuyo acorta un kilómetro."],
    [45,  "Cada audio, otro poquito."],
    [70,  "Ya casi puedo abrazarte…"],
    [92,  "Un poquito más…"],
    [100, "Juntas. Aquí es donde quiero estar. 💞"]
  ],

  cartas: [        // Capítulo 4: [cuándo abrirla, mensaje]
    ["me extrañes",          "Cierra los ojos un segundo. Ahora mismo estoy pensando en ti, te lo prometo."],
    ["tengas un mal día",    "Respira. Eres más fuerte de lo que crees, y estoy de tu lado siempre, aunque sea desde lejos."],
    ["no puedas dormir",     "Imagina que te estoy abrazando. Descansa, mañana hablamos."],
    ["dudes de ti",          "Eres suficiente, eres increíble y eres muy amada. Ojalá pudieras verte con mis ojos."],
    ["quieras sonreír",      "Acuérdate de que alguien, en otro país, sonríe cada vez que le escribes. Esa soy yo."]
  ],

  deseos: [        // Pastel: lo que aparece al tocar la vela otra vez
    "Que este año te trate tan bonito como tú tratas a los demás. ✨",
    "Que el próximo cumpleaños lo celebremos juntas, sin pantallas de por medio. 💗",
    "Que nunca te falten risas, juegos ni pastel de calabaza. 🎃"
  ]
};
/* ═══════════════════════════════════════════════ */
</script>

<style>
:root{
  --fondo1:#ffeaf3; --fondo2:#ffc9df;
  --rosa:#e9468f; --rosa-osc:#b02a6b; --rosa-suave:#ffd6e7;
  --tinta:#4a1236; --tinta2:#8e2a63;
  --calabaza:#ef7627;
  --mariposa:#2a9fe0; --mariposa-osc:#1b6fa3;
  --mariquita:#e0263f; --mariquita-osc:#9c1328;
  --oro:#e3b44c; --emblema:#26336e; --emblema-osc:#151d48; --pergamino:#f6eedd;
  --papel:#fffaf2;
  --r:20px;
  --sombra:0 8px 0 rgba(74,18,54,.12);
  --serif:"Fraunces",Georgia,"Times New Roman",serif;
  --sans:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
  --mano:"Caveat","Segoe Print","Bradley Hand",cursive;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{background:var(--fondo1)}
body{margin:0;font:400 1.05rem/1.6 var(--sans);color:var(--tinta);min-height:100vh;overflow-x:hidden;
  padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0;z-index:-1;background:
  radial-gradient(120% 60% at 50% 0%,#fff6fa 0%,transparent 60%),
  linear-gradient(180deg,var(--fondo1),var(--fondo2))}
h1,h2,h3{font-family:var(--serif);font-weight:700;line-height:1.12;margin:0 0 .35em;letter-spacing:-.01em}
h1{font-size:clamp(2.3rem,10vw,3rem)}
h2{font-size:clamp(1.7rem,7.5vw,2.1rem)}
h3{font-size:1.25rem}
p{margin:.3em 0 1em}
img{max-width:100%;height:auto;display:block}
section{max-width:520px;margin:0 auto;padding:44px 18px;text-align:center;position:relative}
.cap-n{font:700 1.45rem/1 var(--mano);color:var(--rosa);margin:0 0 4px}
.intro{font-family:var(--serif);font-style:italic;color:var(--tinta2);max-width:34ch;margin:0 auto 1.1em}
.mano{font-family:var(--mano);font-weight:700}
.multiply{mix-blend-mode:multiply}
.lesbiana{height:8px;width:150px;margin:18px auto;border-radius:9px;
  background:linear-gradient(90deg,#d52d00 0 20%,#ef7627 20% 40%,#fff 40% 60%,#d162a4 60% 80%,#a30262 80%)}

/* botones */
.btn{font:800 1.02rem/1.2 var(--sans);border:0;border-radius:99px;padding:15px 26px;color:#fff;cursor:pointer;
  background:var(--c,var(--rosa));box-shadow:0 6px 0 var(--s,var(--rosa-osc));transition:transform .08s,box-shadow .08s;
  min-height:48px;touch-action:manipulation}
.btn:active{transform:translateY(5px);box-shadow:0 1px 0 var(--s,var(--rosa-osc))}
.btn:focus-visible,[tabindex]:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid var(--tinta);outline-offset:3px}
.btn.azul{--c:var(--mariposa);--s:var(--mariposa-osc)}
.btn.rojo{--c:var(--mariquita);--s:var(--mariquita-osc)}
.btn.emblema{--c:var(--emblema);--s:var(--emblema-osc);color:var(--oro)}
.btn[disabled]{cursor:default}

/* ───── INICIO ───── */
.hero{padding-top:30px}
.sello{display:inline-block;font:800 .82rem/1 var(--sans);color:var(--rosa-osc);background:#fff;border-radius:99px;padding:8px 14px;box-shadow:0 4px 0 rgba(74,18,54,.1)}
#mariposa{width:min(78%,300px);margin:22px auto 8px;cursor:pointer;animation:aleteo 5s ease-in-out infinite}
@keyframes aleteo{0%,100%{transform:translateY(0) rotate(-2deg)}50%{transform:translateY(-12px) rotate(2deg) scaleX(.96)}}
.hero h1 span{display:block;color:var(--rosa)}
#cuenta{display:flex;gap:8px;justify-content:center;margin:20px 0 4px}
#cuenta div{background:#fff;border-radius:16px;padding:10px 4px 8px;width:72px;box-shadow:var(--sombra)}
#cuenta b{display:block;font:700 1.85rem/1.1 var(--serif);color:var(--rosa);font-variant-numeric:tabular-nums}
#cuenta small{font-size:.8rem;color:var(--tinta2)}
#txtCuenta{font:700 1.5rem/1.2 var(--mano);color:var(--tinta2);margin:6px 0 22px}
.mundos{font-size:1.4rem;letter-spacing:.3em;margin-top:26px;opacity:.85}

/* ───── CAP 1 · LIFE IS STRANGE (diario de Max) ───── */
.diario{background:var(--papel);border-radius:6px 18px 18px 6px;padding:26px 18px 24px;box-shadow:var(--sombra);position:relative;
  background-image:linear-gradient(90deg,transparent 30px,rgba(233,70,143,.25) 30px 32px,transparent 32px),
  repeating-linear-gradient(180deg,transparent 0 31px,rgba(42,159,224,.16) 31px 32px)}
.diario .esquina{position:absolute;right:10px;top:8px;width:40px;transform:rotate(14deg)}
.mini{display:inline-block;width:1.4em;vertical-align:-.3em}
.polaroid{background:#fff;padding:12px 12px 6px;border-radius:4px;box-shadow:0 10px 22px rgba(74,18,54,.16);max-width:300px;margin:4px auto 22px;transform:rotate(-2.5deg);position:relative}
.polaroid::before{content:"";position:absolute;top:-12px;left:12px;width:84px;height:24px;transform:rotate(-8deg);background:rgba(255,214,231,.85);box-shadow:0 1px 2px rgba(0,0,0,.06)}
.foto{position:relative;overflow:hidden;border-radius:2px;aspect-ratio:4/5;background:#f2e8ee}
.foto .fondo{position:absolute;inset:-20px;width:calc(100% + 40px);height:calc(100% + 40px);object-fit:cover;filter:blur(18px) saturate(1.1);opacity:.75;transition:none}
.foto img.principal{position:relative;width:100%;height:100%;object-fit:contain;transition:opacity .3s,filter .3s,transform .3s}
.foto .rw{position:absolute;inset:0;display:grid;place-items:center;font-size:3.6rem;color:#fff;opacity:0;transition:opacity .2s;
  background:radial-gradient(circle,rgba(42,159,224,.35),rgba(42,159,224,.65));text-shadow:0 0 20px #fff}
.rebobinando .foto img.principal{filter:blur(4px) saturate(1.8) hue-rotate(-20deg);transform:scale(1.08) translateX(-12px)}
.rebobinando .foto .rw{opacity:1}
.polaroid figcaption{font:700 1.45rem/1.15 var(--mano);color:#3b3b3b;min-height:3.6em;display:flex;align-items:center;justify-content:center;padding:8px 6px}
.contador{font-size:.85rem;color:var(--tinta2);margin:14px 0 0}
.partners{font:700 1.65rem/1.2 var(--mano);color:var(--mariposa-osc);margin:22px 0 0;transform:rotate(-2deg)}
.partners i{font-style:normal;color:var(--rosa);white-space:nowrap}
.decision{margin-top:42px}
.decision h3{font-family:var(--mano);font-size:2rem;font-weight:700;color:var(--mariposa-osc)}
.opciones{display:grid;gap:10px;margin-top:6px}
.opciones .btn{background:#fff;color:var(--tinta);box-shadow:0 5px 0 #e7b8cd;text-align:left;padding:14px 18px}
.opciones .btn:active{box-shadow:0 1px 0 #e7b8cd}
.opciones .btn.elegida{background:var(--mariposa);color:#fff;box-shadow:0 5px 0 var(--mariposa-osc)}
.consecuencia{display:none;text-align:left;margin-top:14px;background:#14202b;color:#eaf6ff;border-radius:14px;padding:14px 16px;box-shadow:var(--sombra)}
.consecuencia b{display:flex;gap:8px;align-items:center;color:#8fd3ff;font-size:.95rem;margin-bottom:4px}
.aparece{animation:aparece .45s ease-out}
@keyframes aparece{from{opacity:0;transform:translateY(8px)}}

/* ───── CAP 2 · MIRACULOUS ───── */
.yoyo{background:var(--mariquita);border-radius:28px;padding:22px 16px;position:relative;overflow:hidden;box-shadow:0 8px 0 var(--mariquita-osc);color:#fff}
.yoyo::before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.9;background:
  radial-gradient(circle at 8% 12%,#1c1018 0 18px,transparent 19px),
  radial-gradient(circle at 92% 18%,#1c1018 0 14px,transparent 15px),
  radial-gradient(circle at 88% 86%,#1c1018 0 20px,transparent 21px),
  radial-gradient(circle at 10% 82%,#1c1018 0 12px,transparent 13px)}
.yoyo>*{position:relative}
.kwami{width:150px;height:150px;margin:0 auto 6px;position:relative}
.kwami img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;transition:transform .5s,opacity .4s}
#tikki{background:#fff;border-radius:50%;padding:10px;animation:flota 3s ease-in-out infinite}
@keyframes flota{50%{transform:translateY(-8px)}}
#miLogo{border-radius:50%;opacity:0;transform:rotate(-200deg) scale(.3)}
.transformada #tikki{opacity:0;transform:scale(1.6)}
.transformada #miLogo{opacity:1;transform:none}
.globo{background:#fff;color:var(--tinta);border-radius:18px;padding:16px;margin:14px 0 18px;min-height:84px;display:flex;align-items:center;justify-content:center;font-size:1.05rem}
.yoyo .btn{--c:#1c1018;--s:#000}
.carrusel{display:none;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 18px 14px;margin:16px -18px 0;scrollbar-width:none}
.carrusel::-webkit-scrollbar{display:none}
.carrusel img{flex:0 0 84%;scroll-snap-align:center;border-radius:16px;border:4px solid #fff;box-shadow:var(--sombra);aspect-ratio:4/3;object-fit:cover}
.pista{display:none;font:700 1.3rem var(--mano);color:var(--tinta2);margin:0}

/* ───── CAP 3 · FIRE EMBLEM (menú de apoyo) ───── */
.marco{background:var(--emblema);border-radius:14px;padding:6px;box-shadow:0 8px 0 var(--emblema-osc);border:2px solid var(--oro)}
.marco-int{background:var(--pergamino);border-radius:9px;padding:18px 14px;border:1px solid rgba(227,180,76,.7)}
.marco-cab{background:linear-gradient(90deg,var(--emblema-osc),var(--emblema));color:var(--pergamino);border-radius:9px 9px 0 0;margin:-18px -14px 14px;padding:10px 14px;font:700 1rem var(--serif);display:flex;justify-content:space-between;align-items:center}
.marco-cab span{color:var(--oro)}
#feLogo{width:86%;margin:4px auto 12px}
.par{display:flex;align-items:center;justify-content:space-between;gap:8px;background:#fff;border:1px solid #e6dcc4;border-radius:10px;padding:8px 10px;text-align:left}
.par .quien{font:700 1rem var(--serif);color:var(--emblema)}
.rangos{display:flex;gap:6px}
.rangos span{font:700 1.35rem/1 var(--serif);width:36px;height:36px;display:grid;place-items:center;border-radius:8px;color:#c4b99d;transition:all .3s}
.rangos span.on{background:var(--emblema);color:var(--oro);transform:scale(1.12);box-shadow:0 0 0 2px var(--oro)}
.dialogo{background:#fff;border:1px solid #e6dcc4;border-radius:10px;margin:12px 0 16px;padding:14px;min-height:84px;display:flex;align-items:center;justify-content:center;font-size:1.03rem}
.escenaS{display:none;margin-top:18px}
.escenaS img{border-radius:10px;border:3px solid var(--oro);width:100%}
.escenaS p{font:700 1.4rem var(--mano);color:var(--emblema);margin:10px 0 0}
.ficha{display:none;margin-top:16px;text-align:left;background:#fff;border:1px solid #e6dcc4;border-radius:10px;padding:14px}
.ficha h3{font-size:1.05rem;text-align:center;color:var(--emblema);margin-bottom:8px}
.ficha .fila{display:grid;grid-template-columns:82px 1fr 30px;gap:8px;align-items:center;font-size:.93rem;margin:5px 0}
.ficha .fila i{height:9px;border-radius:9px;background:#efe6d2;overflow:hidden;display:block}
.ficha .fila i::after{content:"";display:block;height:100%;width:var(--v);background:linear-gradient(90deg,var(--oro),var(--rosa))}
.ficha .fila b{text-align:right;color:var(--emblema)}
.ficha p{margin:10px 0 0;font-size:.93rem}
.capturaFE{width:100%;margin-top:20px;border-radius:12px;border:3px solid var(--emblema);box-shadow:0 5px 0 rgba(38,51,110,.2)}
.galeriaFE{columns:2;column-gap:10px;margin-top:12px}
.galeriaFE img{width:100%;margin:0 0 10px;border-radius:12px;border:3px solid #fff;box-shadow:0 5px 0 rgba(38,51,110,.15);break-inside:avoid}

/* ───── CAP 4 · DISTANCIA + CARTAS ───── */
.pista-dist{position:relative;height:72px;margin:6px 0 2px}
.pista-dist span{position:absolute;top:8px;font-size:2.7rem;line-height:1;transition:left .15s,right .15s}
#yo{left:0}#ella{right:0;transform:scaleX(-1)}
#cap4 .pista-dist,#txtDist,input[type=range],.btn,.sobre{-webkit-user-select:none;user-select:none}
input[type=range]{width:100%;height:40px;accent-color:var(--rosa);touch-action:pan-y}
#txtDist{font:700 1.5rem/1.2 var(--mano);color:var(--tinta2);min-height:2.4em;margin:6px 0 0}
#vias{display:none;transform:rotate(2deg);margin-top:30px}
#vias .foto{aspect-ratio:auto}
#vias .foto img{height:auto}
.cartas{display:grid;gap:10px;margin-top:8px}
.sobre{display:block;width:100%;text-align:left;font:inherit;color:var(--tinta);background:#fff;border:0;border-radius:14px;padding:14px 16px 14px 52px;position:relative;cursor:pointer;box-shadow:0 5px 0 #e7b8cd;min-height:56px}
.sobre::before{content:"💌";position:absolute;left:14px;top:13px;font-size:1.4rem}
.sobre b{font-weight:800}
.sobre .msj{display:none;font:700 1.35rem/1.25 var(--mano);color:var(--rosa-osc);margin-top:6px}
.sobre.abierta{box-shadow:0 0 0 2px var(--rosa),0 5px 0 #e7b8cd;cursor:default}
.sobre.abierta::before{content:"💗"}
.sobre.abierta .msj{display:block;animation:aparece .45s ease-out}

/* ───── CAP 5 · CANCIÓN ───── */
.tocadiscos{background:#fff;border-radius:var(--r);padding:22px 18px;box-shadow:var(--sombra)}
.disco{width:170px;height:170px;border-radius:50%;margin:4px auto 16px;position:relative;
  background:radial-gradient(circle,var(--rosa) 0 15%,#fff 15.5% 16.5%,var(--rosa) 17% 23%,#1d1520 23.5% 100%);
  box-shadow:0 8px 0 rgba(74,18,54,.18);animation:girar 7s linear infinite;animation-play-state:paused}
.disco::before{content:"";position:absolute;inset:0;border-radius:50%;background:repeating-radial-gradient(circle,transparent 0 5px,rgba(255,255,255,.05) 5px 6px);
  -webkit-mask:radial-gradient(circle,transparent 24%,#000 25%);mask:radial-gradient(circle,transparent 24%,#000 25%)}
.disco::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:12px;margin:-6px;border-radius:50%;background:#fff}
.disco.sonando{animation-play-state:running}
@keyframes girar{to{transform:rotate(360deg)}}
#cancion h2{margin-bottom:0}
#cArtista{color:var(--tinta2);margin:2px 0 16px}
#cFrase{font:700 1.75rem/1.2 var(--mano);color:var(--rosa-osc);margin:0 0 4px}
.enlaces{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:14px}
.enlaces a{text-decoration:none;display:inline-block}
.enlaces .spotify{--c:#1db954;--s:#128a3e}
.reproductor iframe{width:100%;height:152px;border:0;border-radius:12px;margin-top:14px;display:block}
.reproductor audio{width:100%;margin-top:14px}

/* ───── FINAL · PASTEL + CARTA ───── */
#tarta{width:min(290px,80%);margin:4px auto 0;cursor:pointer;display:block;overflow:visible;outline:none;border-radius:24px}
#tarta:focus-visible{box-shadow:0 0 0 3px var(--rosa)}
#llama{transform-origin:150px 60px;animation:llama .9s ease-in-out infinite alternate}
@keyframes llama{to{transform:scale(1.1,.9) rotate(4deg)}}
#humo{opacity:0}
.apagada #llama{display:none}
.apagada #humo{animation:humo 1.6s ease-out forwards}
@keyframes humo{0%{opacity:.8;transform:translateY(0)}100%{opacity:0;transform:translateY(-30px)}}
#deseo{font:700 1.45rem/1.25 var(--mano);color:var(--tinta2);min-height:2.6em;display:flex;align-items:center;justify-content:center;margin:10px 0 0}
.carta{background:var(--papel);border-radius:6px;padding:30px 22px 26px;text-align:left;font:400 1.08rem/1.75 var(--serif);
  box-shadow:0 14px 30px rgba(74,18,54,.16);position:relative;margin-top:14px}
.carta::before{content:"";position:absolute;top:-14px;left:50%;width:110px;height:28px;transform:translateX(-50%) rotate(-2deg);background:rgba(255,214,231,.9)}
.carta .saludo{font:700 1.9rem/1.1 var(--mano);color:var(--rosa-osc);margin-bottom:.6em}
.carta .firma{font:700 1.8rem/1.1 var(--mano);color:var(--rosa);text-align:right;margin:1em 0 0}
.galeria{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:10px 18px 20px;margin:0 -18px}
.galeria figure{flex:0 0 78%;margin:0;scroll-snap-align:center;transform:none}
.pie{text-align:center;color:var(--tinta2);padding:10px 18px calc(60px + env(safe-area-inset-bottom));font-size:.95rem}

#confeti{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:20}
.oculto{display:none!important}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<canvas id="confeti" aria-hidden="true"></canvas>

<!-- ═════════ INICIO ═════════ -->
<section class="hero">
  <span class="sello">Episodio especial · 30 de noviembre</span>
  <img id="mariposa" data-img="mariposa" alt="Una mariposa azul" >
  <h1>Feliz cumpleaños, <span id="nombre"></span></h1>
  <p class="intro">Te hice esto con las cosas que sé que te gustan y que han sido parte de nuestra historia. Tiene cinco capítulos, y en todos la protagonista eres tú.</p>
  <div id="cuenta" aria-label="Cuenta regresiva"></div>
  <p id="txtCuenta"></p>
  <button class="btn" id="empezar">Empezar ✨</button>
  <div class="mundos" aria-hidden="true">🦋🐞⚔️🎃</div>
</section>

<!-- ═════════ CAPÍTULO 1 · LIFE IS STRANGE ═════════ -->
<section id="cap1">
  <p class="cap-n">Capítulo 1</p>
  <h2>Rebobinar</h2>
  <p class="intro">Max podía retroceder el tiempo. Si yo pudiera, lo usaría para volver a elegirte, una y otra vez.</p>
  <div class="diario">
    <img class="esquina" data-img="mariposa" alt="">
    <figure class="polaroid" id="polaroid">
      <div class="foto"><img class="fondo" id="lisFondo" data-img="lis-abrazo" alt=""><img class="principal" id="lisImg" data-img="lis-abrazo" alt="Max y Chloe abrazándose"><div class="rw" aria-hidden="true">⏪</div></div>
      <figcaption id="lisTxt" aria-live="polite">Toca «rebobinar» y mira mis recuerdos favoritos de ti.</figcaption>
    </figure>
    <button class="btn azul" id="bRew">⏪ Rebobinar</button>
    <p class="contador" id="lisN"></p>
    <p class="partners">Siempre seré tu <i>partner in crime</i>,<br>y tú serás mi <i>partner in time</i>.</p>
  </div>

  <div class="decision">
    <h3>Tus decisiones importan</h3>
    <p>Cuando por fin nos veamos, ¿qué hacemos primero?</p>
    <div class="opciones" id="opciones"></div>
    <div class="consecuencia" id="consec" aria-live="polite"><b><img class="mini" data-img="mariposa" alt="">Esta decisión tendrá consecuencias.</b><span id="consecTxt"></span></div>
  </div>
</section>

<!-- ═════════ CAPÍTULO 2 · MIRACULOUS ═════════ -->
<section id="cap2">
  <p class="cap-n">Capítulo 2</p>
  <h2>Mi Lady</h2>
  <p class="intro">Tikki está lista. Tres toques y empieza la transformación.</p>
  <div class="yoyo" id="yoyo">
    <div class="kwami">
      <img id="tikki" class="multiply" data-img="tikki" alt="Tikki">
      <img id="miLogo" data-img="mir-logo" alt="Emblemas de Ladybug y Cat Noir">
    </div>
    <div class="globo" id="miTxt" aria-live="polite">Psst… soy Tikki. ¿Lista para transformarte?</div>
    <button class="btn" id="bMir"></button>
  </div>
  <div class="carrusel" id="carrusel">
    <img data-img="mir-risa" alt="Marinette y Zoé riendo" loading="lazy">
    <img data-img="mir-numero" alt="Zoé le da su número a Marinette" loading="lazy">
    <img data-img="mir-escena" alt="Zoé y Marinette conversando" loading="lazy">
  </div>
  <p class="pista" id="pista">desliza para ver más →</p>
</section>

<!-- ═════════ CAPÍTULO 3 · FIRE EMBLEM ═════════ -->
<section id="cap3">
  <p class="cap-n">Capítulo 3</p>
  <h2>Conversación de apoyo</h2>
  <p class="intro">Como Byleth y Edelgard: empezamos en C y llegamos hasta S.</p>
  <div class="marco">
    <div class="marco-int">
      <div class="marco-cab">Apoyo <span>✦</span></div>
      <img id="feLogo" class="multiply" data-img="fe-logo" alt="Fire Emblem">
      <div class="par">
        <span class="quien">Tú &amp; yo</span>
        <div class="rangos" id="rangos" aria-label="Nivel de apoyo"><span class="on">C</span><span>B</span><span>A</span><span>S</span></div>
      </div>
      <div class="dialogo" id="feTxt" aria-live="polite"></div>
      <button class="btn emblema" id="bFE">⚔️ Subir apoyo</button>

      <div class="escenaS" id="escenaS">
        <img data-img="fe-beso" alt="Byleth y Edelgard besándose" loading="lazy">
        <p>Escena de apoyo S desbloqueada 💍</p>
      </div>
      <div class="ficha" id="ficha">
        <h3>Ficha de unidad: <span class="nombreElla"></span></h3>
        <div class="fila">PV<i style="--v:100%"></i><b>∞</b></div>
        <div class="fila">Encanto<i style="--v:99%"></i><b>99</b></div>
        <div class="fila">Ternura<i style="--v:99%"></i><b>99</b></div>
        <div class="fila">Valentía<i style="--v:96%"></i><b>96</b></div>
        <div class="fila">Risa<i style="--v:98%"></i><b>98</b></div>
        <p><b>Clase:</b> Emperatriz de mi corazón<br><b>Habilidad:</b> Abrazo crítico (acierta siempre)</p>
      </div>
    </div>
  </div>
  <div class="galeriaFE">
    <img data-img="fe-par1" alt="Edelgard y Byleth" loading="lazy">
    <img data-img="fe-cabeza" alt="Byleth acariciando la cabeza de Edelgard" loading="lazy">
    <img data-img="fe-par2" alt="Byleth y Edelgard" loading="lazy">
    <img data-img="fe-cerca" alt="Byleth tomando el rostro de Edelgard" loading="lazy">
  </div>
</section>

<!-- ═════════ CAPÍTULO 4 · DISTANCIA ═════════ -->
<section id="cap4">
  <p class="cap-n">Capítulo 4</p>
  <h2>La distancia</h2>
  <p class="intro">Hay kilómetros entre nosotras, pero se pueden acortar. Desliza.</p>
  <div class="pista-dist" aria-hidden="true"><span id="yo"><img data-img="mariposa" alt="" style="width:58px"></span><span id="ella">🐞</span></div>
  <input type="range" id="sl" min="0" max="100" value="0" aria-label="Acercarnos">
  <p id="txtDist" aria-live="polite"></p>
  <figure class="polaroid" id="vias">
    <div class="foto"><img data-img="lis-rieles" alt="Max y Chloe de la mano en las vías" loading="lazy"></div>
    <figcaption>Un día caminaremos así de cerca.</figcaption>
  </figure>

  <h3 style="margin-top:38px">Ábrelas cuando…</h3>
  <p class="intro" style="margin-bottom:.6em">Para que me lleves contigo a todas partes.</p>
  <div class="cartas" id="cartas"></div>
</section>

<!-- ═════════ CAPÍTULO 5 · CANCIÓN ═════════ -->
<section id="cancion">
  <p class="cap-n">Capítulo 5</p>
  <p class="intro" style="margin-bottom:.4em">La canción que me recuerda a ti</p>
  <div class="tocadiscos">
    <div class="disco" id="disco" aria-hidden="true"></div>
    <h2 id="cTitulo"></h2>
    <p id="cArtista"></p>
    <p id="cFrase"></p>
    <div class="reproductor" id="cPlayer"></div>
  </div>
</section>

<!-- ═════════ FOTOS (opcional) ═════════ -->
<section id="fotos" class="oculto">
  <h2>Nuestros recuerdos</h2>
  <div class="galeria" id="galeria"></div>
</section>

<!-- ═════════ FINAL ═════════ -->
<section id="final">
  <p class="cap-n">Final</p>
  <h2>Tu pastel de calabaza</h2>
  <p class="intro">Toca la vela y pide un deseo.</p>
  <svg id="tarta" viewBox="0 0 300 260" role="button" tabindex="0" aria-label="Pastel de calabaza: toca para apagar la vela">
    <ellipse cx="150" cy="236" rx="138" ry="18" fill="#f3a6c8"/>
    <ellipse cx="150" cy="229" rx="136" ry="18" fill="#fff"/>
    <path d="M52 122v88c0 15 44 25 98 25s98-10 98-25v-88z" fill="#e8741f"/>
    <path d="M52 122v88c0 15 44 25 98 25V122z" fill="#f0862e" opacity=".55"/>
    <path d="M52 172c0 15 44 25 98 25s98-10 98-25v-12c0 15-44 25-98 25s-98-10-98-25z" fill="#ffe1ec"/>
    <ellipse cx="150" cy="122" rx="98" ry="25" fill="#f7a04a"/>
    <path d="M52 122c0 15 44 25 98 25s98-10 98-25v16c0 15-44 25-98 25s-98-10-98-25z" fill="#ffe1ec"/>
    <path d="M66 146q9 24 18 2M104 156q9 24 18 2M178 156q9 24 18 2M216 146q9 24 18 2" fill="#ffe1ec" stroke="#ffe1ec" stroke-width="7" stroke-linecap="round"/>
    <g fill="#e9468f"><circle cx="90" cy="118" r="3"/><circle cx="210" cy="116" r="3"/><circle cx="118" cy="132" r="2.6"/><circle cx="186" cy="131" r="2.6"/></g>
    <g fill="#2a9fe0"><circle cx="104" cy="112" r="2.4"/><circle cx="196" cy="126" r="2.4"/></g>
    <g transform="translate(150 108)">
      <path d="M0 0c-27 0-37 12-37 24s10 18 37 18 37-6 37-18S27 0 0 0z" fill="#ef7627"/>
      <path d="M0 0c-11 4-15 14-15 24s4 16 15 18c11-2 15-8 15-24S11 4 0 0z" fill="#d35f12"/>
      <path d="M-2 1q-1-12 8-17" stroke="#3f7d32" stroke-width="5" fill="none" stroke-linecap="round"/>
      <path d="M6-15c10-6 19 0 17 6-9 2-15-2-17-6z" fill="#6cbf4d"/>
    </g>
    <rect x="144" y="62" width="12" height="32" rx="3" fill="#e9468f"/>
    <path d="M144 70l12-4v6l-12 4zM144 82l12-4v6l-12 4z" fill="#fff"/>
    <g id="llama"><path d="M150 30c-11 13-11 21 0 30 11-9 11-17 0-30z" fill="#ffc93c"/><path d="M150 42c-5 6-5 11 0 15 5-4 5-9 0-15z" fill="#fff6d6"/></g>
    <path id="humo" d="M150 58c-6-8 6-12 0-20s6-12 0-18" stroke="#b9a3b0" stroke-width="3" fill="none" stroke-linecap="round"/>
  </svg>
  <p id="deseo" aria-live="polite"></p>

  <div class="lesbiana" aria-hidden="true" style="margin-top:34px"></div>

  <article class="carta">
    <p class="saludo">Para ti, <span class="nombreElla"></span>:</p>
    <p>Quería regalarte algo que pudieras llevar en el bolsillo, porque así quiero estar yo contigo: siempre cerca, aunque haya kilómetros de por medio.</p>
    <p>Eres mi persona favorita, mi heroína y mi línea temporal preferida. Contigo, hasta esperar que la distancia termine se siente como parte de una aventura.</p>
    <p>No importa cuántos mapas nos separen: te elijo hoy, mañana y en cada línea de tiempo posible. Gracias por existir, por ser exactamente como eres y por dejarme quererte.</p>
    <p>Feliz cumpleaños. Falta menos para poder estar juntas.</p>
    <p class="firma">Con todo mi amor,<br><span id="firma"></span></p>
  </article>
</section>

<p class="pie">🦋 🐞 ⚔️ 🎃<br>Hecho con amor, a distancia.</p>

<script>
const IMG={"fe-beso":"data:image/jpeg;base64,","fe-cabeza":"data:image/jpeg;base64,","fe-cerca":"data:image/jpeg;base64,","fe-logo":"data:image/jpeg;base64,","fe-par1":"data:image/jpeg;base64,","fe-par2":"data:image/jpeg;base64,","lis-abrazo":"data:image/jpeg;base64,","lis-beso":"data:image/jpeg;base64,","lis-chibi":"data:image/jpeg;base64,","lis-double":"data:image/jpeg;base64,","lis-rieles":"data:image/jpeg;base64,","mariposa":"data:image/webp;base64,","mir-escena":"data:image/jpeg;base64,","mir-logo":"data:image/jpeg;base64,","mir-numero":"data:image/jpeg;base64,","mir-risa":"data:image/jpeg;base64,","tikki":"data:image/jpeg;base64,"};
(function(){
"use strict";
const $=id=>document.getElementById(id);
const quieto=matchMedia("(prefers-reduced-motion: reduce)").matches;
const vibra=ms=>{try{navigator.vibrate&&navigator.vibrate(ms)}catch(e){}};
const capital=s=>s.charAt(0).toUpperCase()+s.slice(1);

/* imágenes */
document.querySelectorAll("[data-img]").forEach(el=>{if(IMG[el.dataset.img])el.src=IMG[el.dataset.img]});
CFG.recuerdos.forEach(r=>{const i=new Image();i.src=IMG[r[0]]||r[0]});

/* nombres */
$("nombre").textContent=CFG.ella+" 💗";
document.querySelectorAll(".nombreElla").forEach(e=>e.textContent=CFG.ella);
$("firma").textContent=CFG.yo;
document.title="Feliz cumpleaños, "+CFG.ella+" 💗";

/* ── cuenta regresiva ── */
function cuenta(){
  const n=new Date(),m=CFG.mes-1,f=new Date(n.getFullYear(),m,CFG.dia);
  const box=$("cuenta"),txt=$("txtCuenta");
  if(n.getMonth()===m&&n.getDate()===CFG.dia){box.innerHTML="";txt.textContent="¡Hoy es tu día! 🎂";return false}
  if(n>f){box.innerHTML="";txt.textContent="Y te sigo celebrando todos los días. 💗";return false}
  const s=Math.floor((f-n)/1000);
  const v=[[Math.floor(s/86400),"días"],[Math.floor(s%86400/3600),"horas"],[Math.floor(s%3600/60),"min"],[s%60,"seg"]];
  box.innerHTML=v.map(x=>"<div><b>"+x[0]+"</b><small>"+x[1]+"</small></div>").join("");
  txt.textContent="para tu cumpleaños";return true;
}
if(cuenta()){const t=setInterval(()=>{if(!cuenta())clearInterval(t)},1000)}
const esHoy=(()=>{const n=new Date();return n.getMonth()===CFG.mes-1&&n.getDate()===CFG.dia})();

$("empezar").onclick=()=>$("cap1").scrollIntoView({behavior:quieto?"auto":"smooth"});
$("mariposa").onclick=()=>{vibra(15);boom(["🦋","💗","✨"],$("mariposa"))};

/* ── Cap 1: rebobinar ── */
let ri=-1;
$("bRew").onclick=()=>{
  ri=(ri+1)%CFG.recuerdos.length;const r=CFG.recuerdos[ri],p=$("polaroid");
  p.classList.add("rebobinando");vibra([10,40,10]);
  setTimeout(()=>{$("lisImg").src=$("lisFondo").src=IMG[r[0]]||r[0];$("lisTxt").textContent=r[1];
    $("lisN").textContent="Recuerdo "+(ri+1)+" de "+CFG.recuerdos.length;p.classList.remove("rebobinando")},quieto?0:420);
};
CFG.decisiones.forEach(o=>{
  const b=document.createElement("button");b.className="btn";b.textContent=o[0];
  b.onclick=()=>{document.querySelectorAll(".opciones .btn").forEach(x=>x.classList.remove("elegida"));b.classList.add("elegida");
    const c=$("consec");c.style.display="block";$("consecTxt").textContent=o[1];c.classList.remove("aparece");void c.offsetWidth;c.classList.add("aparece");vibra(15)};
  $("opciones").appendChild(b);
});

/* ── Cap 2: Miraculous ── */
let mi=0;const bMir=$("bMir");bMir.textContent=CFG.miraculous[0][0];
bMir.onclick=()=>{
  if(mi>=CFG.miraculous.length){mi=0;$("yoyo").classList.remove("transformada");$("miTxt").textContent="Psst… soy Tikki. ¿Otra vez?";bMir.textContent=CFG.miraculous[0][0];return}
  const m=CFG.miraculous[mi];$("miTxt").textContent=m[1];vibra(20);
  if(mi===0)$("yoyo").classList.add("transformada");
  mi++;
  if(mi<CFG.miraculous.length)bMir.textContent=CFG.miraculous[mi][0];
  else{bMir.textContent="🔁 Otra vez";boom(["🐞","🐾","💗","🍀"],$("yoyo"));$("carrusel").style.display="flex";$("pista").style.display="block"}
};

/* ── Cap 3: apoyo ── */
let ai=0;$("feTxt").textContent=CFG.apoyo[0][1];
$("bFE").onclick=()=>{
  if(ai>=CFG.apoyo.length-1)return;ai++;vibra(20);
  [...$("rangos").children].forEach((s,i)=>s.classList.toggle("on",i===ai));
  const t=$("feTxt");t.textContent=CFG.apoyo[ai][1];t.classList.remove("aparece");void t.offsetWidth;t.classList.add("aparece");
  if(ai===CFG.apoyo.length-1){
    const b=$("bFE");b.textContent="Apoyo S alcanzado 💍";b.disabled=true;
    $("escenaS").style.display="block";$("ficha").style.display="block";
    boom(["💍","⚔️","💗","✨"],$("rangos"));
    setTimeout(()=>$("escenaS").scrollIntoView({behavior:quieto?"auto":"smooth",block:"center"}),500);
  }
};

/* ── Cap 4: distancia ── */
let juntas=false;$("txtDist").textContent=CFG.distancia[0][1];
$("sl").oninput=e=>{
  const v=+e.target.value,pos="calc("+(v*0.5)+"% - "+(v*0.27)+"px)";
  $("yo").style.left=pos;$("ella").style.right=pos;
  let t=CFG.distancia[0][1];CFG.distancia.forEach(d=>{if(v>=d[0])t=d[1]});$("txtDist").textContent=t;
  if(v>=100&&!juntas){juntas=true;$("yo").firstChild.style.display="none";$("yo").insertAdjacentHTML("beforeend","<b id=abrazo style=font-weight:400>🫂</b>");$("ella").style.visibility="hidden";
    const f=$("vias");f.style.display="block";f.classList.add("aparece");vibra([20,60,20]);boom(["🦋","🐞","💞"],$("sl"))}
  else if(v<100&&juntas){juntas=false;$("yo").firstChild.style.display="";const ab=$("abrazo");ab&&ab.remove();$("ella").style.visibility="visible"}
};
CFG.cartas.forEach(c=>{
  const b=document.createElement("button");b.className="sobre";b.setAttribute("aria-expanded","false");
  b.innerHTML="Ábrela cuando <b></b><span class='msj'></span>";b.querySelector("b").textContent=c[0];b.querySelector(".msj").textContent=c[1];
  b.onclick=()=>{b.classList.add("abierta");b.setAttribute("aria-expanded","true");vibra(10)};
  $("cartas").appendChild(b);
});

/* ── Cap 5: canción ── */
(function(){
  const c=CFG.cancion,box=$("cPlayer"),disco=$("disco");
  $("cTitulo").textContent="«"+c.titulo+"»";$("cArtista").textContent=c.artista;$("cFrase").textContent=c.frase;
  const limpia=s=>String(s).replace(/[^\w-]/g,"");
  if(c.archivo){                       // mp3 propio: canción completa
    const a=document.createElement("audio");a.controls=true;a.preload="none";a.src=c.archivo;
    a.onplay=()=>disco.classList.add("sonando");a.onpause=a.onended=()=>disco.classList.remove("sonando");box.appendChild(a);
  }else if(c.spotify){                 // reproductor de Spotify dentro de la página
    const id=limpia(c.spotify),hueco=document.createElement("div");box.appendChild(hueco);
    const simple=()=>{if(box.querySelector("iframe"))return;hueco.outerHTML='<iframe height="152" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" title="Reproductor de Spotify" src="https://open.spotify.com/embed/track/'+id+'"></iframe>'};
    window.onSpotifyIframeApiReady=api=>{try{api.createController(hueco,{uri:"spotify:track:"+id,width:"100%",height:152},ctrl=>{
      ctrl.addListener("playback_update",e=>disco.classList.toggle("sonando",!e.data.isPaused))})}catch(e){simple()}};
    const sc=document.createElement("script");sc.src="https://open.spotify.com/embed/iframe-api/v1";sc.async=true;sc.onerror=simple;document.body.appendChild(sc);
    setTimeout(simple,6000);
  }else if(c.youtube){
    box.innerHTML='<iframe height="210" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="Reproductor de YouTube" src="https://www.youtube-nocookie.com/embed/'+limpia(c.youtube)+'?playsinline=1"></iframe>';
  }
})();

/* ── fotos propias (opcional) ── */
if(CFG.fotos.length){$("fotos").classList.remove("oculto");
  CFG.fotos.forEach(s=>{const f=document.createElement("figure");f.className="polaroid";const im=document.createElement("img");
    im.src=s;im.alt="Una foto de nosotras";im.loading="lazy";f.appendChild(im);$("galeria").appendChild(f)})}

/* ── pastel ── */
let di=-1;$("deseo").textContent="";
function soplar(){
  const t=$("tarta");
  if(!t.classList.contains("apagada")){t.classList.add("apagada");vibra([30,50,30]);boom(["🎃","🎂","💗","🦋","🐞"],t);
    $("deseo").textContent="Deseo pedido. Toca otra vez y te cuento los míos.";t.setAttribute("aria-label","Pastel de calabaza: toca para ver mis deseos");return}
  di=(di+1)%CFG.deseos.length;const d=$("deseo");d.textContent=CFG.deseos[di];d.classList.remove("aparece");void d.offsetWidth;d.classList.add("aparece");
}
$("tarta").onclick=soplar;
$("tarta").onpointerdown=e=>e.preventDefault();
$("tarta").onkeydown=e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();soplar()}};

/* ── confeti ── */
const cv=$("confeti"),cx=cv.getContext("2d");let ps=[],raf=0,dpr=1;
function medir(){dpr=Math.min(devicePixelRatio||1,2);cv.width=innerWidth*dpr;cv.height=innerHeight*dpr;cx.setTransform(dpr,0,0,dpr,0,0)}
medir();addEventListener("resize",medir);
window.boom=function(ems,el){
  if(quieto)return;
  ems=ems||["💗","🦋","🐞","🎃"];
  const cs=["#e9468f","#ffd6e7","#2a9fe0","#e3b44c","#e0263f","#ef7627"];
  let ox=innerWidth/2,oy=innerHeight/2;
  if(el){const r=el.getBoundingClientRect();ox=r.left+r.width/2;oy=Math.min(Math.max(r.top+r.height/2,60),innerHeight-60)}
  for(let i=0;i<80;i++){const a=Math.random()*Math.PI*2,v=4+Math.random()*9;
    ps.push({x:ox,y:oy,vx:Math.cos(a)*v,vy:Math.sin(a)*v-6,rot:Math.random()*6,vr:(Math.random()-.5)*.3,c:cs[i%cs.length],e:i%4===0?ems[i%ems.length]:null,s:6+Math.random()*6,life:0})}
  if(!raf)raf=requestAnimationFrame(paso);
};
function paso(){
  cx.clearRect(0,0,innerWidth,innerHeight);
  ps.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.32;p.vx*=.99;p.rot+=p.vr;p.life++;
    cx.save();cx.translate(p.x,p.y);cx.rotate(p.rot);
    if(p.e){cx.font="22px serif";cx.textAlign="center";cx.fillText(p.e,0,0)}else{cx.fillStyle=p.c;cx.fillRect(-p.s/2,-p.s*.3,p.s,p.s*.6)}
    cx.restore()});
  ps=ps.filter(p=>p.y<innerHeight+40&&p.life<260);
  raf=ps.length?requestAnimationFrame(paso):(cx.clearRect(0,0,innerWidth,innerHeight),0);
}
if(esHoy)setTimeout(()=>boom(["🎂","💗","🎃","🦋"]),700);
})();
</script>
